---
import '../styles/global.css';
const { title } = Astro.props;
---
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-background text-on-surface font-body min-h-screen flex flex-col">
    
    <nav class="fixed top-0 w-full z-50 bg-background/80 backdrop-blur-xl border-b border-outline-variant/30 animate-fade-in">
      <div class="flex justify-between items-center h-16 px-margin-mobile md:px-margin-desktop max-w-[1200px] mx-auto w-full">
        <a href="/" class="text-headline-md text-primary hover:opacity-80 transition-opacity duration-300 group relative">
          BUILT_BY_SUBRAJ
          <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-primary-container group-hover:w-full transition-all duration-300"></span>
        </a>
        
        <div class="hidden md:flex gap-8 items-center">
          <a class="text-code-sm text-on-surface-variant hover:text-primary transition-colors duration-300 relative group" href="/projects">
            Projects
            <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-primary group-hover:w-full transition-all duration-300"></span>
          </a>
          <a class="text-code-sm text-on-surface-variant hover:text-primary transition-colors duration-300 relative group" href="/blog">
            Blog
            <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-primary group-hover:w-full transition-all duration-300"></span>
          </a>
          <a class="text-code-sm text-on-surface-variant hover:text-primary transition-colors duration-300 relative group" href="/">
            About
            <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-primary group-hover:w-full transition-all duration-300"></span>
          </a>
        </div>
        
        <a href="/Subraj-Kumar-JNU.pdf" target="_blank" rel="noopener noreferrer" class="bg-primary-container text-surface-container-lowest text-code-sm px-4 py-2 rounded hover:opacity-80 transition-all scale-95 hover:scale-100 glow-button hidden md:block inline-block">
          Resume
        </a>
        
        <button class="md:hidden text-on-surface-variant hover:text-primary transition-colors duration-200">
          <span class="material-symbols-outlined">menu</span>
        </button>
      </div>
    </nav>

    <main class="flex-grow pt-24 px-margin-mobile md:px-margin-desktop max-w-[1200px] mx-auto w-full">
      <slot />
    </main>

  </body>
</html>