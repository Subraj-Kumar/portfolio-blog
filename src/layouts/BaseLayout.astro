---
const { title } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
  </head>
  <body class="bg-gray-900 text-white min-h-screen">
    <nav class="p-6 flex gap-6">
      <a href="/">Home</a>
      <a href="/blog">Blog</a>
    </nav>
    <main class="max-w-4xl mx-auto p-6">
      <slot />
    </main>
  </body>
</html>