---
import BaseLayout from '../layouts/BaseLayout.astro';
import profilePhoto from '../assets/profile photo.png';
---
<BaseLayout title="Subraj Kumar | Full-Stack & Computer Vision Engineer">
  
  <section class="mb-section-gap pt-12 hero-section">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter items-center">
      <div class="lg:col-span-7 animate-slide-in-left">
        <span class="inline-block px-4 py-2 bg-primary-container/20 border border-primary-container/50 rounded-full text-primary-container font-code-sm text-code-sm mb-6 animate-fade-in">
          B.Tech CSE @ JNU, New Delhi
        </span>
        <h1 class="font-display-lg-mobile md:font-display-lg text-display-lg-mobile md:text-display-lg text-on-surface mb-6 tracking-tighter leading-tight">
          Hi, I'm <span class="text-primary-container">Subraj Kumar.</span><br />
          Full-Stack Engineer<br class="hidden md:block" /> & Vision Systems Builder
        </h1>
        <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl mb-8 leading-relaxed">
          I architect end-to-end platforms combining <span class="text-primary-container">production Flutter apps</span> with <span class="text-primary-container">real-time computer vision pipelines</span>. From Firebase-powered marketplaces to YOLO-based occupancy detection, I engineer systems that scale.
        </p>
        
        <div class="flex flex-wrap items-center gap-4 mb-8">
          <a href="mailto:kumarsubraj97@gmail.com" class="px-6 py-3 bg-primary-container text-on-primary font-label-caps text-label-caps hover:opacity-90 hover:-translate-y-1 transition-all glow-button rounded flex items-center gap-2">
            <span class="material-symbols-outlined text-lg">mail</span>
            Get in Touch
          </a>
          <a href="/projects" class="px-6 py-3 border border-primary-container/50 text-primary-container font-label-caps text-label-caps hover:bg-primary-container/10 transition-all rounded flex items-center gap-2">
            <span class="material-symbols-outlined text-lg">folder_open</span>
            View Work
          </a>
        </div>

        <div class="flex items-center gap-5 text-on-surface-variant animate-fade-in" style="animation-delay: 0.3s;">
          <a href="https://github.com/Subraj-Kumar" target="_blank" rel="noopener noreferrer" class="hover:text-primary-container hover:scale-110 transition-all" aria-label="GitHub">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.02c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A4.8 4.8 0 0 0 8 18v4"></path></svg>
          </a>
          <a href="https://www.linkedin.com/in/subraj-kumar" target="_blank" rel="noopener noreferrer" class="hover:text-primary-container hover:scale-110 transition-all" aria-label="LinkedIn">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
          </a>
        </div>
      </div>
      <div class="lg:col-span-5 flex justify-end mt-12 lg:mt-0 animate-slide-in-right">
        <div class="relative w-full max-w-[400px] aspect-square rounded-lg overflow-hidden border border-outline-variant grayscale hover:grayscale-0 transition-all duration-700 hover-glow group">
          <img src={profilePhoto.src} alt="Subraj Kumar" class="object-cover w-full h-full group-hover:scale-105 transition-transform duration-700" />
          <div class="absolute inset-0 bg-gradient-to-t from-surface to-transparent opacity-40"></div>
        </div>
      </div>
    </div>
  </section>

  <section class="mb-section-gap capabilities-grid">
    <div class="mb-16">
      <h2 class="font-display-lg-mobile md:font-display-lg text-display-lg-mobile md:text-display-lg text-on-surface mb-4 tracking-tight animate-slide-up">Technical Expertise</h2>
      <p class="font-body-lg text-body-lg text-on-surface-variant max-w-3xl">Specializing in full-stack development, real-time systems, and AI-powered applications</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter">
      <div class="p-8 bg-surface-container-low border border-outline-variant rounded-lg group surface-raised hover-glow stagger-item">
        <span class="material-symbols-outlined text-primary-container mb-6 text-5xl group-hover:scale-110 transition-transform duration-300">layers</span>
        <h3 class="font-headline-md text-headline-md text-on-surface mb-3">Full-Stack Platforms</h3>
        <p class="font-body-md text-body-md text-on-surface-variant mb-4">Building complete applications with React, Node.js, Express, Flask, and Flutter—from API design to real-time databases.</p>
        <div class="flex flex-wrap gap-2">
          <span class="px-2 py-1 bg-surface-container-high text-code-sm text-primary-container rounded">React</span>
          <span class="px-2 py-1 bg-surface-container-high text-code-sm text-on-surface-variant rounded">Node.js</span>
          <span class="px-2 py-1 bg-surface-container-high text-code-sm text-on-surface-variant rounded">Firebase</span>
          <span class="px-2 py-1 bg-surface-container-high text-code-sm text-on-surface-variant rounded">Flutter</span>
        </div>
      </div>
      <div class="p-8 bg-surface-container-low border border-outline-variant rounded-lg group surface-raised hover-glow stagger-item">
        <span class="material-symbols-outlined text-primary-container mb-6 text-5xl group-hover:scale-110 transition-transform duration-300">image_search</span>
        <h3 class="font-headline-md text-headline-md text-on-surface mb-3">Computer Vision</h3>
        <p class="font-body-md text-body-md text-on-surface-variant mb-4">Engineering real-time vision pipelines using YOLO, OpenCV, and Python—detecting occupancy, analyzing live feeds.</p>
        <div class="flex flex-wrap gap-2">
          <span class="px-2 py-1 bg-surface-container-high text-code-sm text-primary-container rounded">YOLO</span>
          <span class="px-2 py-1 bg-surface-container-high text-code-sm text-on-surface-variant rounded">OpenCV</span>
          <span class="px-2 py-1 bg-surface-container-high text-code-sm text-on-surface-variant rounded">Python</span>
        </div>
      </div>
      <div class="p-8 bg-surface-container-low border border-outline-variant rounded-lg group surface-raised hover-glow stagger-item">
        <span class="material-symbols-outlined text-primary-container mb-6 text-5xl group-hover:scale-110 transition-transform duration-300">trending_up</span>
        <h3 class="font-headline-md text-headline-md text-on-surface mb-3">Competitive Programming</h3>
        <p class="font-body-md text-body-md text-on-surface-variant mb-4">2nd Runner-up at BIG'O' EngQuest 3.0—strong foundations in DSA, optimization, and algorithmic problem-solving.</p>
        <div class="flex flex-wrap gap-2">
          <span class="px-2 py-1 bg-surface-container-high text-code-sm text-primary-container rounded">DSA</span>
          <span class="px-2 py-1 bg-surface-container-high text-code-sm text-on-surface-variant rounded">C++</span>
          <span class="px-2 py-1 bg-surface-container-high text-code-sm text-on-surface-variant rounded">Java</span>
        </div>
      </div>
    </div>
  </section>

  <section class="mb-section-gap">
    <div class="mb-16">
      <h2 class="font-display-lg-mobile md:font-display-lg text-display-lg-mobile md:text-display-lg text-on-surface mb-4 tracking-tight animate-slide-up">Featured Projects</h2>
      <p class="font-body-lg text-body-lg text-on-surface-variant max-w-3xl">Selected work showcasing production systems and technical depth</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-gutter mb-12">
      <a href="/projects/getnear" class="group block">
        <div class="relative overflow-hidden rounded-xl border border-outline-variant bg-surface-container-low surface-raised hover-glow transition-all duration-300 p-8 h-full flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-3 mb-6">
              <span class="material-symbols-outlined text-primary-container text-4xl">location_on</span>
              <span class="inline-block px-3 py-1 bg-primary-container/20 border border-primary-container/50 text-primary-container font-code-sm text-code-sm rounded-full">Production</span>
            </div>
            <h3 class="font-display-lg-mobile text-display-lg-mobile text-on-surface mb-3 group-hover:text-primary-container transition-colors duration-300">
              GetNear
            </h3>
            <p class="font-body-md text-body-md text-on-surface-variant">
              Hyperlocal marketplace with geolocation discovery, AI-powered recommendations, and Firebase infrastructure.
            </p>
          </div>
          <div class="flex items-center gap-2 text-primary-container font-code-sm text-code-sm mt-8 group-hover:translate-x-1 transition-transform duration-300">
            <span>View Project</span>
            <span class="material-symbols-outlined text-lg">arrow_forward</span>
          </div>
        </div>
      </a>

      <a href="/projects/campus-connect" class="group block">
        <div class="relative overflow-hidden rounded-xl border border-outline-variant bg-surface-container-low surface-raised hover-glow transition-all duration-300 p-8 h-full flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-3 mb-6">
              <span class="material-symbols-outlined text-primary-container text-4xl">event_note</span>
              <span class="inline-block px-3 py-1 bg-primary-container/20 border border-primary-container/50 text-primary-container font-code-sm text-code-sm rounded-full">Full Stack</span>
            </div>
            <h3 class="font-display-lg-mobile text-display-lg-mobile text-on-surface mb-3 group-hover:text-primary-container transition-colors duration-300">
              CampusConnect
            </h3>
            <p class="font-body-md text-body-md text-on-surface-variant">
              Event management platform with RBAC, multi-step workflows, OAuth authentication, and cloud integration.
            </p>
          </div>
          <div class="flex items-center gap-2 text-primary-container font-code-sm text-code-sm mt-8 group-hover:translate-x-1 transition-transform duration-300">
            <span>View Project</span>
            <span class="material-symbols-outlined text-lg">arrow_forward</span>
          </div>
        </div>
      </a>
    </div>

    <div class="text-center">
      <a href="/projects" class="inline-flex items-center gap-2 px-8 py-4 bg-primary-container/10 border border-primary-container/30 text-primary-container font-label-caps text-label-caps rounded-lg hover:bg-primary-container/20 hover:border-primary-container/60 transition-all group">
        <span>View All Projects</span>
        <span class="material-symbols-outlined group-hover:translate-x-1 transition-transform duration-300">arrow_forward</span>
      </a>
    </div>
  </section>

  <section class="mb-section-gap">
    <div class="mb-16">
      <h2 class="font-display-lg-mobile md:font-display-lg text-display-lg-mobile md:text-display-lg text-on-surface mb-4 tracking-tight animate-slide-up">Professional Journey</h2>
      <p class="font-body-lg text-body-lg text-on-surface-variant max-w-3xl">Experience and leadership</p>
    </div>
    <div class="space-y-8 mb-16">
      <div class="pl-8 relative group animate-slide-in-left">
        <div class="absolute left-0 top-4 w-3 h-3 rounded-full bg-primary-container glow-shadow group-hover:scale-150 transition-transform duration-300 -translate-x-1.5"></div>
        <span class="inline-block font-code-sm text-code-sm text-primary-container px-3 py-1 bg-primary-container/20 border border-primary-container/50 rounded-full mb-3">CURRENT</span>
        <div class="mb-4">
          <h3 class="font-headline-md text-headline-md text-on-surface mb-1">Software Developer (Client Project)</h3>
          <p class="font-label-caps text-label-caps text-on-surface-variant">GetNear — Hyperlocal Marketplace | Feb 2026 – May 2026</p>
        </div>
        <p class="font-body-md text-body-md text-on-surface-variant mb-4 max-w-3xl leading-relaxed">
          Built a production Android marketplace (Flutter/Dart) enabling real-time geolocation-based product inquiries. Integrated Firebase authentication, Firestore real-time database, Cloud Storage, and FCM notifications. Engineered 1:1 in-app chat, AI-powered product suggestions with Cloud Vision API, and blood donation module with role-based security.
        </p>
        <div class="flex flex-wrap gap-2">
          <span class="px-3 py-1 bg-surface-container-high border border-outline-variant/30 text-code-sm text-primary-container rounded hover:border-primary-container transition-colors">Flutter</span>
          <span class="px-3 py-1 bg-surface-container-high border border-outline-variant/30 text-code-sm text-on-surface rounded hover:border-primary-container transition-colors">Dart</span>
          <span class="px-3 py-1 bg-surface-container-high border border-outline-variant/30 text-code-sm text-on-surface rounded hover:border-primary-container transition-colors">Firebase</span>
          <span class="px-3 py-1 bg-surface-container-high border border-outline-variant/30 text-code-sm text-on-surface rounded hover:border-primary-container transition-colors">Cloud Functions</span>
          <span class="px-3 py-1 bg-surface-container-high border border-outline-variant/30 text-code-sm text-on-surface rounded hover:border-primary-container transition-colors">Google Cloud Vision</span>
        </div>
      </div>

      <div class="pl-8 relative group animate-slide-in-right">
        <div class="absolute left-0 top-4 w-3 h-3 rounded-full bg-outline-variant group-hover:bg-primary-container group-hover:scale-150 transition-all duration-300 -translate-x-1.5"></div>
        <span class="inline-block font-code-sm text-code-sm text-on-surface-variant px-3 py-1 bg-surface-container-high border border-outline-variant/30 rounded-full mb-3">AUG 2025 – PRESENT</span>
        <div class="mb-4">
          <h3 class="font-headline-md text-headline-md text-on-surface mb-1">Executive</h3>
          <p class="font-label-caps text-label-caps text-on-surface-variant">Loop: The Developer's Club | School of Engineering, JNU</p>
        </div>
        <p class="font-body-md text-body-md text-on-surface-variant mb-4 max-w-3xl leading-relaxed">
          Organized technical workshops on full-stack development and data structures; authored standard operating procedures and executed hackathons. Increased student engagement by 20% through initiatives bridging theory and industry practices.
        </p>
      </div>
    </div>
  </section>

  <section class="mb-section-gap">
    <div class="mb-12">
      <h2 class="font-display-lg-mobile md:font-display-lg text-display-lg-mobile md:text-display-lg text-on-surface mb-4 tracking-tight animate-slide-up">Technical Arsenal</h2>
      <p class="font-body-lg text-body-lg text-on-surface-variant">Languages, frameworks, and tools</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-gutter">
      <div class="p-8 bg-surface-container-low border border-outline-variant rounded-lg surface-raised hover-glow stagger-item">
        <h3 class="font-headline-md text-headline-md text-on-surface mb-6">Languages</h3>
        <div class="flex flex-wrap gap-2">
          <span class="px-4 py-2 bg-primary-container/20 border border-primary-container/50 text-on-surface font-code-sm rounded-lg">C</span>
          <span class="px-4 py-2 bg-primary-container/20 border border-primary-container/50 text-on-surface font-code-sm rounded-lg">C++</span>
          <span class="px-4 py-2 bg-primary-container/20 border border-primary-container/50 text-on-surface font-code-sm rounded-lg">Java</span>
          <span class="px-4 py-2 bg-primary-container/20 border border-primary-container/50 text-on-surface font-code-sm rounded-lg">Python</span>
          <span class="px-4 py-2 bg-primary-container/20 border border-primary-container/50 text-on-surface font-code-sm rounded-lg">JavaScript</span>
          <span class="px-4 py-2 bg-primary-container/20 border border-primary-container/50 text-on-surface font-code-sm rounded-lg">Dart</span>
        </div>
      </div>
      <div class="p-8 bg-surface-container-low border border-outline-variant rounded-lg surface-raised hover-glow stagger-item">
        <h3 class="font-headline-md text-headline-md text-on-surface mb-6">Frontend & Mobile</h3>
        <div class="flex flex-wrap gap-2">
          <span class="px-4 py-2 bg-surface-container-high border border-outline-variant/30 text-on-surface font-code-sm rounded-lg">React</span>
          <span class="px-4 py-2 bg-surface-container-high border border-outline-variant/30 text-on-surface font-code-sm rounded-lg">HTML5</span>
          <span class="px-4 py-2 bg-surface-container-high border border-outline-variant/30 text-on-surface font-code-sm rounded-lg">CSS3</span>
          <span class="px-4 py-2 bg-surface-container-high border border-outline-variant/30 text-on-surface font-code-sm rounded-lg">Tailwind</span>
          <span class="px-4 py-2 bg-surface-container-high border border-outline-variant/30 text-on-surface font-code-sm rounded-lg">Flutter</span>
        </div>
      </div>
      <div class="p-8 bg-surface-container-low border border-outline-variant rounded-lg surface-raised hover-glow stagger-item">
        <h3 class="font-headline-md text-headline-md text-on-surface mb-6">Backend & APIs</h3>
        <div class="flex flex-wrap gap-2">
          <span class="px-4 py-2 bg-surface-container-high border border-outline-variant/30 text-on-surface font-code-sm rounded-lg">Node.js</span>
          <span class="px-4 py-2 bg-surface-container-high border border-outline-variant/30 text-on-surface font-code-sm rounded-lg">Express</span>
          <span class="px-4 py-2 bg-surface-container-high border border-outline-variant/30 text-on-surface font-code-sm rounded-lg">Flask</span>
          <span class="px-4 py-2 bg-surface-container-high border border-outline-variant/30 text-on-surface font-code-sm rounded-lg">REST APIs</span>
          <span class="px-4 py-2 bg-surface-container-high border border-outline-variant/30 text-on-surface font-code-sm rounded-lg">JWT</span>
