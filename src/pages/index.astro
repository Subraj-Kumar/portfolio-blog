        <div class="flex flex-wrap gap-2">
          <span class="px-4 py-2 bg-surface-container-high border border-outline-variant/30 text-on-surface font-code-sm rounded-lg">MongoDB</span>
          <span class="px-4 py-2 bg-surface-container-high border border-outline-variant/30 text-on-surface font-code-sm rounded-lg">Firebase</span>
          <span class="px-4 py-2 bg-surface-container-high border border-outline-variant/30 text-on-surface font-code-sm rounded-lg">Firestore</span>
          <span class="px-4 py-2 bg-surface-container-high border border-outline-variant/30 text-on-surface font-code-sm rounded-lg">MySQL</span>
          <span class="px-4 py-2 bg-surface-container-high border border-outline-variant/30 text-on-surface font-code-sm rounded-lg">Git</span>
        </div>
