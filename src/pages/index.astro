      <div class="absolute bottom-0 left-0 w-48 h-48 bg-secondary-container/5 rounded-full blur-[80px] animate-pulse" style="animation-delay: 0.5s"></div>
      
      <h2 class="font-display-lg-mobile md:font-display-lg text-display-lg-mobile md:text-display-lg text-on-surface mb-4 relative z-10">Let's build something great together.</h2>
      <p class="font-body-lg text-body-lg text-on-surface-variant mb-10 relative z-10 max-w-2xl mx-auto">Whether it's production systems, vision pipelines, or scaling platforms—let's collaborate.</p>
      
      <div class="flex flex-col md:flex-row justify-center items-center gap-4 relative z-10 mb-10">
        <a href="mailto:kumarsubraj97@gmail.com" class="px-10 py-4 bg-primary-container text-on-primary font-label-caps text-label-caps hover:opacity-90 hover:-translate-y-1 transition-all flex items-center justify-center gap-2 glow-button rounded active:translate-y-0 w-full md:w-auto">
