  </section>

  <section class="mb-section-gap">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
      <div class="animate-slide-in-left">
        <h2 class="font-headline-md text-headline-md text-on-surface mb-8">Education</h2>
        <div class="p-8 bg-surface-container-low border border-outline-variant rounded-lg surface-raised hover-glow">
          <span class="inline-block font-code-sm text-code-sm text-primary-container px-3 py-1 bg-primary-container/20 border border-primary-container/50 rounded-full mb-4">2023 – 2027</span>
          <h3 class="font-headline-md text-headline-md text-on-surface mb-2">B.Tech Computer Science Engineering</h3>
          <p class="font-label-caps text-label-caps text-on-surface-variant mb-6">Jawaharlal Nehru University, New Delhi</p>
          <div class="space-y-4">
            <div class="flex justify-between items-center">
              <span class="font-body-md text-body-md text-on-surface">CGPA</span>
              <span class="font-headline-md text-headline-md text-primary-container">7.21 / 9</span>
            </div>
            <div class="h-px bg-outline-variant/20"></div>
            <div>
              <p class="font-label-caps text-label-caps text-on-surface-variant mb-3">LEADERSHIP ROLES</p>
              <ul class="space-y-2">
                <li class="flex items-center gap-2 text-body-md text-on-surface">
                  <span class="w-1.5 h-1.5 rounded-full bg-primary-container"></span>
                  Executive, Loop: The Developer's Club
                </li>
                <li class="flex items-center gap-2 text-body-md text-on-surface">
                  <span class="w-1.5 h-1.5 rounded-full bg-primary-container"></span>
                  Secretary, Ephirium (Gaming & Game Dev Club)
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>

      <div class="animate-slide-in-right">
        <h2 class="font-headline-md text-headline-md text-on-surface mb-8">Achievements & Honors</h2>
        <div class="space-y-4">
          <div class="p-6 bg-surface-container-low border border-outline-variant rounded-lg surface-raised hover-glow group cursor-pointer">
