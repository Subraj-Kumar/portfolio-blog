---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

// Generate a static page for every markdown file in the blog collection
export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map(entry => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
// Render the markdown content into HTML
const { Content } = await render(entry);
---

<BaseLayout title={`${entry.data.title} | SYS.DEV`}>
  <article class="max-w-3xl mx-auto pb-section-gap pt-12">
    
    <!-- Blog Header -->
    <header class="mb-12 border-b border-outline-variant/20 pb-12">
      <div class="flex items-center gap-4 mb-6">
        <span class="font-code-sm text-code-sm text-primary-container px-2 py-1 rounded bg-[#1A1A1A] border border-outline-variant/30">
          {entry.data.tags && entry.data.tags.length > 0 ? entry.data.tags[0].toUpperCase() : 'LOG'}
        </span>
        <span class="font-code-sm text-code-sm text-tertiary-fixed-dim">
          {entry.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        </span>
        {entry.data.readingTime && (
          <span class="font-code-sm text-code-sm text-tertiary-fixed-dim flex items-center gap-2 border-l border-outline-variant pl-4">
            <span class="material-symbols-outlined text-[14px]">schedule</span>
            {entry.data.readingTime}
          </span>
        )}
      </div>

      <h1 class="font-display-lg-mobile md:font-display-lg text-display-lg-mobile md:text-display-lg text-primary mb-6 tracking-tighter">
        {entry.data.title}
      </h1>
      
      <p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed">
        {entry.data.description}
      </p>
    </header>

    <!-- Markdown Content Wrapper -->
    <div class="markdown-content font-body-md text-body-md">
      <Content />
    </div>

    <!-- Navigation Footer -->
    <section class="border-t border-outline-variant/30 pt-12 mt-24 flex justify-between items-center">
      <a class="font-code-sm text-code-sm text-on-surface-variant hover:text-primary-container transition-colors flex items-center gap-2" href="/blog">
        <span class="material-symbols-outlined text-sm">arrow_back</span>
        Back to Logs
      </a>
    </section>

  </article>
</BaseLayout>

<!-- 
  This style block automatically targets the raw HTML generated by your Markdown files
  and styles it to match your technical design system. 
-->
<style is:global>
  .markdown-content h1, 
  .markdown-content h2, 
  .markdown-content h3 {
    font-family: var(--font-display);
    color: var(--color-on-surface);
    margin-top: 3rem;
    margin-bottom: 1.5rem;
    font-weight: 600;
  }
  
  .markdown-content h2 {
    font-size: 24px; /* headline-md */
    line-height: 1.3;
  }

  .markdown-content h3 {
    font-size: 20px;
    color: var(--color-primary);
  }

  .markdown-content p {
    color: var(--color-on-surface-variant);
    margin-bottom: 1.5rem;
    line-height: 1.7;
  }

  .markdown-content ul {
    list-style-type: disc;
    padding-left: 1.5rem;
    color: var(--color-on-surface-variant);
    margin-bottom: 1.5rem;
  }

  .markdown-content li {
    margin-bottom: 0.5rem;
  }

  /* Inline Code (e.g., `const x = 5`) */
  .markdown-content code:not(pre code) {
    font-family: var(--font-mono);
    font-size: 14px;
    background-color: #1A1A1A;
    color: var(--color-primary-container);
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    border: 1px solid var(--color-outline-variant);
  }

  /* Code Blocks */
  .markdown-content pre {
    background-color: #050505 !important;
    padding: 1.5rem;
    border-radius: 8px;
    border: 1px solid #262626;
    overflow-x: auto;
    margin-bottom: 2rem;
    margin-top: 1.5rem;
  }

  .markdown-content pre code {
    font-family: var(--font-mono);
    font-size: 14px;
    background-color: transparent;
    color: var(--color-on-surface-variant);
    padding: 0;
    border: none;
  }
</style>